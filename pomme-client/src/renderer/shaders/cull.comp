#version 450

// Every section's frustum, occlusion-graph and facing test, into the draw
// lists; with the occlusion pass, only the sections it saw last frame, the
// rest left to it and cull_late.comp.

#include "cull.glsl"

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= chunk_count) return;

    ChunkMeta m = chunks[idx];
    if (m.index_count == 0u && m.water_index_count == 0u) return;
    uint base = arena_start(m);
    // A slot in the segment's headroom holds a section that has gone.
    if (idx - base >= arena_len[m.arena >> 2][m.arena & 3u]) return;
    if (use_visibility != 0u && (column_visibility[m.column] & (1u << m.section)) == 0u) {
        return;
    }

    // Vanilla `RenderSection.getVisibility`; `chunk.vert` keeps what's near
    // the camera fully visible.
    float visibility = 1.0;
    if (m.uploaded_ms != 0u && fade_ms != 0u) {
        visibility = min(float(now_ms - m.uploaded_ms) / float(fade_ms), 1.0);
    }
    chunks[idx].visibility = floatBitsToUint(visibility);

    vec3 mn;
    vec3 mx;
    section_box(m, mn, mx);

    for (int i = 0; i < 6; i++) {
        vec4 p = planes[i];
        float d = p.x * (p.x >= 0.0 ? mx.x : mn.x)
                + p.y * (p.y >= 0.0 ? mx.y : mn.y)
                + p.z * (p.z >= 0.0 ? mx.z : mn.z)
                + p.w;
        if (d < 0.0) return;
    }

    if (use_occlusion == 0u) {
        emit_opaque(m, base, idx, mn, mx);
        emit_water(m, base, idx);
        return;
    }
    // Drawn now if the occlusion pass saw it last frame, or if the eye is at
    // its box; the pass tests it either way, and cull_late.comp draws it if
    // it shows but wasn't drawn here, and its water if it shows at all.
    bool near = all(lessThan(mn, vec3(NEAR_BOX))) && all(greaterThan(mx, vec3(-NEAR_BOX)));
    if (near) {
        seen[idx] = frame_id;
    }
    bool drawn = near || seen[idx] == frame_id - 1u;
    uint slot = atomicAdd(candidate_count, 1u);
    candidates[slot] = idx | (drawn ? DRAWN_BIT : 0u);
    atomicMax(late_groups, slot / 64u + 1u);
    if (drawn) {
        emit_opaque(m, base, idx, mn, mx);
    }
}
